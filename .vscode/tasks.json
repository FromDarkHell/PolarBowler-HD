{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (x86 Debug)",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-Command",
        "cmake --preset x86 && cmake --build --preset x86-debug"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Deploy DLL",
      "type": "process",
      "dependsOn": "Build (x86 Debug)",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/.vscode/deploy.ps1",
        "-DllPath",
        "${workspaceFolder}/build/Debug/PolarBowler-HD.dll"
      ],
      "problemMatcher": []
    },
    {
      "label": "Deploy and Run Game",
      "type": "process",
      "dependsOn": "Build (x86 Debug)",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/.vscode/deploy.ps1",
        "-DllPath",
        "${workspaceFolder}/build/Debug/PolarBowler-HD.dll",
        "-Launch",
        "${input:game}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "game",
      "type": "pickString",
      "description": "Game to launch",
      "options": [
        "Polar Bowler Classic",
        "Polar Golfer",
        "Polar Golfer - Pineapple Cup"
      ],
      "default": "Polar Bowler Classic"
    }
  ]
}
